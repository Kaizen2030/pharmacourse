# Frontend (Vite) public values only. Never put the Supabase service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local Windows development; for the public Vercel site, use your HTTPS tunnel URL.
VITE_WA_GATEWAY_URL=http://localhost:8787

# Optional general website-support handoff. Separate from tutor/course WhatsApp numbers.
VITE_SUPPORT_WA_NUMBER=
# RemedacarePOS Supabase project used by the patient portal (public anon key, not the service key).
# Also set both in Vercel > Project > Settings > Environment Variables, or the build stops.
VITE_PHARMACYOS_SUPABASE_URL=
VITE_PHARMACYOS_SUPABASE_ANON_KEY=
